{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medico-backend-9t2h.onrender.com/api/:path*"
    },
    {
      "source": "/admin/assets/:path*",
      "destination": "/admin/assets/:path*"
    },
    {
      "source": "/admin/favicon.svg",
      "destination": "/admin/favicon.svg"
    },
    {
      "source": "/admin/icons.svg",
      "destination": "/admin/icons.svg"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
